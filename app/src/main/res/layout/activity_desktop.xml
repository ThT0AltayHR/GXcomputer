<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.gxcomputer.app.desktop.NatureBackgroundView
        android:id="@+id/natureBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Üst bilgi çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/storageText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gx_text_secondary"
            android:textSize="13sp"
            tools:text="112 GB boş alan kullanılabilir" />

        <ImageView
            android:id="@+id/weatherIconTop"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_weather_sun"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/weatherTextTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/gx_text_primary"
            android:textSize="13sp"
            tools:text="22°C" />

        <TextView
            android:id="@+id/clockTextTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gx_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            tools:text="14:32" />
    </LinearLayout>

    <!-- Haberler paneli - sağ üstte, saatin altında -->
    <LinearLayout
        android:id="@+id/newsPanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desktop_news_title"
            android:textColor="@color/gx_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/newsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/desktop_news_needs_api_key"
            android:textColor="@color/gx_text_primary"
            android:textSize="12sp"
            android:maxLines="6" />
    </LinearLayout>

    <!-- İlk kurulum ilerlemesi -->
    <LinearLayout
        android:id="@+id/setupProgressPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_card"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/setupStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/desktop_first_run_preparing"
            android:textColor="@color/gx_text_primary"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/setupProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="100" />
    </LinearLayout>

    <!-- Cihaz klavyesini açma - sağ üst köşe, çok şeffaf -->
    <ImageView
        android:id="@+id/nativeKeyboardToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:padding="9dp"
        android:alpha="0.35"
        android:background="@drawable/bg_keyboard_key"
        android:src="@drawable/ic_keyboard"
        android:contentDescription="@string/desktop_toggle_keyboard" />

    <EditText
        android:id="@+id/nativeKeyboardTrigger"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|end"
        android:background="@null"
        android:textColor="@android:color/transparent" />

    <!-- Sanal imleç - dokunmatik alan (touchpad) modu: parmağı sürükleyip göreceli olarak imleci hareket ettirir -->
    <ImageView
        android:id="@+id/virtualCursor"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:src="@drawable/ic_cursor"
        android:elevation="20dp"
        android:contentDescription="@null" />

    <!-- Alt Dock -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dock"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/dockFileManager"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="6dp"
            android:src="@drawable/ic_file_manager"
            android:contentDescription="@string/file_manager_title" />

        <ImageView
            android:id="@+id/dockTerminal"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:padding="6dp"
            android:src="@drawable/ic_terminal"
            android:contentDescription="@string/terminal_title" />

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="10dp"
            android:background="#33FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dockRecycler"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/dockAddApp"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:padding="14dp"
            android:background="@drawable/bg_keyboard_key"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/desktop_install_app" />

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="10dp"
            android:background="#33FFFFFF" />

        <ImageView
            android:id="@+id/dockLock"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:background="@drawable/bg_keyboard_key"
            android:src="@drawable/ic_avatar_default"
            android:contentDescription="@string/desktop_lock" />

        <ImageView
            android:id="@+id/dockShutdown"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:padding="13dp"
            android:background="@drawable/bg_keyboard_key"
            android:src="@drawable/ic_power"
            android:contentDescription="@string/desktop_shutdown" />
    </LinearLayout>

    <!-- Bilgisayarı kapatma geçişi - yavaşça kararıp uygulamadan çıkar -->
    <View
        android:id="@+id/shutdownOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone" />

</FrameLayout>
